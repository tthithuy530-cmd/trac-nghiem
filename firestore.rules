rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /players/{userId} {
   allow get: if request.auth != null;
   allow list: if request.auth != null && request.query.limit <= 50;
   allow create: if request.auth != null && request.auth.uid == userId
     && request.resource.data.keys().hasOnly(['uid','name','bestScore','bestDurationSeconds','rankValue','gamesPlayed','createdAt','updatedAt'])
     && request.resource.data.uid == userId
     && request.resource.data.name is string
     && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 32
     && request.resource.data.bestScore == 0
     && request.resource.data.bestDurationSeconds == 300
     && request.resource.data.rankValue == 0 && request.resource.data.gamesPlayed == 0;
   allow update: if request.auth != null && request.auth.uid == userId
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bestScore','bestDurationSeconds','rankValue','gamesPlayed','updatedAt'])
     && request.resource.data.uid == resource.data.uid
     && request.resource.data.name == resource.data.name
     && request.resource.data.gamesPlayed == resource.data.gamesPlayed + 1
     && request.resource.data.bestScore is int
     && request.resource.data.bestScore >= resource.data.bestScore
     && request.resource.data.bestScore <= 5
     && request.resource.data.bestDurationSeconds is int
     && request.resource.data.bestDurationSeconds >= 0
     && request.resource.data.bestDurationSeconds <= 300
     && request.resource.data.rankValue == request.resource.data.bestScore * 1000 + (300 - request.resource.data.bestDurationSeconds)
     && request.resource.data.rankValue >= resource.data.rankValue;
   allow delete: if false;
  }
  match /attempts/{attemptId} {
   allow create: if request.auth != null
     && request.resource.data.keys().hasOnly(['uid','score','durationSeconds','createdAt'])
     && request.resource.data.uid == request.auth.uid
     && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 5
     && request.resource.data.durationSeconds is int
     && request.resource.data.durationSeconds >= 0 && request.resource.data.durationSeconds <= 300;
   allow read, update, delete: if false;
  }
 }
}